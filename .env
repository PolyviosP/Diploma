# Ρυθμίσεις ανάπτυξης — το αρχείο είναι στο repo, δεν χρειάζεται αντιγραφή.
#
# Οι τιμές είναι τα defaults του docker-compose και ΔΕΝ είναι μυστικά: η βάση
# ακούει μόνο τοπικά, με κωδικό που αλλάζει με ένα `docker compose down -v`.
#
# Ό,τι είναι πραγματικά μυστικό (client secret του Keycloak, κλειδιά του MinIO)
# πάει σε .env.local, που μένει εκτός git — και σε production έρχεται από secret
# manager, ποτέ από αρχείο στο repo. Το Next.js δίνει προτεραιότητα στο .env.local
# έναντι αυτού εδώ, οπότε η παράκαμψη γίνεται χωρίς να πειραχτεί το .env.

# Native ανάπτυξη: η βάση εκτίθεται στο localhost:5432 από το compose.
DATABASE_URL=postgresql://diploma:diploma@localhost:5432/diploma

# Μέσα σε container το hostname είναι "postgres" — ορίζεται ήδη στα compose αρχεία:
# DATABASE_URL=postgresql://diploma:diploma@postgres:5432/diploma

# ---------------------------------------------------------------------------
# Auth.js + Keycloak
# ---------------------------------------------------------------------------

# Κλειδί υπογραφής/κρυπτογράφησης του session cookie. Η τιμή εδώ είναι ΜΟΝΟ για
# ανάπτυξη — σε production έρχεται από secret manager. Παράγεται με:
#   npx auth secret     ή     openssl rand -base64 32
AUTH_SECRET=dev-only-Yb3nQe1sK9pW2xR7tV5uZ0aC4dF6gH8j

# Πίσω από proxy/container το Next δεν μαντεύει σωστά το origin του callback.
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Ο client του realm. Το secret είναι fixture του keycloak/diploma-realm.json,
# δεν είναι μυστικό παραγωγής — εκεί ρυθμίζεται νέο από το admin console.
AUTH_KEYCLOAK_ID=diploma-app
AUTH_KEYCLOAK_SECRET=diploma-app-secret

# Δημόσιο issuer: εκεί ανακατευθύνεται ο browser και αυτό είναι το `iss` των
# tokens. Μένει localhost ακόμη και μέσα σε container (δες KC_HOSTNAME).
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/diploma

# Προαιρετικό: server-to-server διεύθυνση για token/userinfo/certs. Χρειάζεται
# μόνο όταν η εφαρμογή τρέχει σε container (`docker compose --profile app up`),
# όπου το localhost:8080 δεν είναι το Keycloak — ορίζεται εκεί στο compose.
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/diploma

# ---------------------------------------------------------------------------
# MinIO — αποθήκευση αρχείων μέσω S3 API
# ---------------------------------------------------------------------------

# Πού μιλάει ο server. Native ανάπτυξη: το compose εκθέτει το API στο 9000.
# Μέσα σε container γίνεται http://minio:9000 — ορίζεται εκεί στο compose.
S3_ENDPOINT=http://localhost:9000

# Πού δείχνουν τα presigned URL, δηλαδή τι βλέπει ο browser. Ξεχωριστή μεταβλητή
# γιατί η υπογραφή SigV4 καλύπτει και τον `Host`: URL υπογεγραμμένο για
# `minio:9000` απορρίπτεται όταν ζητηθεί από `localhost:9000`. Ίδιο σκεπτικό με
# το ζεύγος AUTH_KEYCLOAK_ISSUER / KEYCLOAK_INTERNAL_ISSUER παραπάνω.
S3_PUBLIC_ENDPOINT=http://localhost:9000

S3_BUCKET=diploma
S3_REGION=us-east-1

# Ο χρήστης της εφαρμογής — ΟΧΙ ο root του MinIO. Το minio/init.sh του δίνει
# policy που φτάνει μόνο μέχρι το bucket `diploma`. Τιμές ανάπτυξης· σε
# production έρχονται από secret manager.
S3_ACCESS_KEY=diploma-app
S3_SECRET_KEY=diploma-app-secret

# Root credentials του MinIO. Τα βλέπουν μόνο το ίδιο το MinIO και το init
# container — η εφαρμογή ποτέ.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
