# Αντίγραψε αυτό το αρχείο σε .env και προσάρμοσε αν χρειάζεται.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Οι τιμές εδώ είναι τα defaults του docker-compose και ΔΕΝ είναι μυστικά —
# η βάση ακούει μόνο τοπικά. Σε production ο κωδικός έρχεται από secret manager.

# Native ανάπτυξη: η βάση εκτίθεται στο localhost:5432 από το compose.
DATABASE_URL=postgresql://diploma:diploma@localhost:5432/diploma

# Μέσα σε container το hostname είναι "postgres" — ορίζεται ήδη στο docker-compose.yml:
# DATABASE_URL=postgresql://diploma:diploma@postgres:5432/diploma
